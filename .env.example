# 環境設定檔
# 複製此檔案並重命名為 .env，然後填入您的 API 密鑰

# Flask 環境
FLASK_ENV=development
FLASK_DEBUG=True

API_PROVIDER=gemini

# Google Gemini API (推薦 - 更強大的 Vision 模型)
# 取得方式: https://aistudio.google.com/ -> Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 備用 Key（主額度用盡時先切換同牌備用）
GEMINI_BACKUP_API_KEY=
GEMINI_BACKUP_MODEL=

# Google Cloud Vision API (備選)
# 取得方式: https://cloud.google.com/vision/docs/setup
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Claude Vision API (備選)
# 取得方式: https://www.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# ========== 備援辨識（預設關閉）==========
# 目前影像辨識只走 Gemini 主/備 key，下面三行可留空；
# 若未來要接 OpenAI / OpenRouter / 其他 OpenAI 相容端點再填入。
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=
OPENAI_FALLBACK_BASE_URL=

# ========== AI 諮詢 ==========
# 預設使用 Groq 免費層（OpenAI 相容介面，不需綡信用卡）
# 取得方式：https://console.groq.com/keys -> Create API Key（gsk_ 開頭）
# 若要改用 OpenAI：把 base_url 改為 https://api.openai.com/v1、model 改為 gpt-4o-mini
OPENAI_CONSULT_API_KEY=
OPENAI_CONSULT_MODEL=llama-3.3-70b-versatile
OPENAI_CONSULT_BASE_URL=https://api.groq.com/openai/v1

# 切換策略
AI_FALLBACK_ENABLED=true
AI_FALLBACK_COOLDOWN_SEC=300
AI_FALLBACK_FAIL_THRESHOLD=3
AI_TIMEOUT_SEC=20
AI_MAX_RETRY=1

# 諮詢成本控管
AI_CONSULT_MAX_TOKENS=800
AI_CONSULT_RATE_PER_MIN=20

# JWT 認證密鑰（Production 必填！開發環境可省略會自動生成）
# 請使用 python -c "import os; print(os.urandom(32).hex())" 生成
JWT_SECRET_KEY=your_jwt_secret_key_here

# 檔案上傳設定
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=10485760

# 藥物資料庫路徑
DATABASE_PATH=drug_recognition.db

# 辨識設定
MIN_CONFIDENCE=0.3
MAX_RESULTS=5

# 日誌等級
LOG_LEVEL=INFO
